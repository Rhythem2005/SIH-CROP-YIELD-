# Frontend Environment Variables (for Vercel)
# NOTE: API_BASE_URL is injected at build time by deployment platform

# Weather API (used in InputData.jsx)
VITE_OPENWEATHER_KEY=your_openweather_api_key_here

# =================================
# DO NOT ADD GEMINI KEY HERE
# =================================
# Gemini API is now called via backend only (/api/chat)
# Remove VITE_REACT_APP_GEMINI_KEY from .env for security
